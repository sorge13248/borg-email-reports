# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = direct TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=borg@example.com
SMTP_PASS=smtp-password
SMTP_FROM="Borg Reports <borg@example.com>"

# ── Borg passphrases per repo ──────────────────────────────────────────────────────
# Key format: BORG_PASSPHRASE__{folder-name-inside-/home/app}
# Used only when passphrase.sh is absent from the repo folder.
BORG_PASSPHRASE__my-repo=repo-passphrase
BORG_PASSPHRASE__other-repo=other-passphrase

# ── Optional ────────────────────────────────────────────────────────────────────────
# Run a check immediately on startup (useful for testing)
RUN_ON_STARTUP=false
# Per-command borg timeout in milliseconds (default: 300000 = 5 min)
# BORG_COMMAND_TIMEOUT_MS=300000
